[Unit]
Description=Bridge live Codex prompt state to roadmap single writer
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/daniele/projects/codex-roadmap
ExecStart=/usr/bin/python3 /home/daniele/projects/codex-roadmap/tools/roadmap_live_watch.py --repo /home/daniele/projects/codex-roadmap --source-root /home/daniele/.codex/sessions
Nice=10
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
