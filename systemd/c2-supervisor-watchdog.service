[Unit]
ConditionPathExists=!%h/.local/state/c3-control/c2-retired.json
Description=Detect and fence an expired C2 supervisor
ConditionPathExists=%h/.local/state/c2-supervisor/lease.sqlite3
ConditionPathExists=!%h/.config/c2/disable-chat-supervisor

[Service]
Type=oneshot
ExecStartPre=/usr/bin/python3 /home/daniele/.local/share/c2-supervisor/worktree/tools/c2_worktree_guard.py --sync
ExecStart=/usr/bin/python3 /home/daniele/.local/share/c2-supervisor/worktree/tools/c2_supervisor_watchdog.py
TimeoutStartSec=120
