[Unit]
Description=Advance Checklist 2.0 from the accepted roadmap snapshot
After=codex-roadmap-sync.service
ConditionPathExists=/home/daniele/projects/codex-roadmap/roadmap.sqlite

[Service]
Type=oneshot
EnvironmentFile=%h/.config/c2-supervisor/runtime.env
ExecStart=/usr/bin/python3 /home/daniele/projects/codex-roadmap/tools/c2_runtime.py --supervisor-id ${C2_SUPERVISOR_ID} --fencing-token ${C2_FENCING_TOKEN}
TimeoutStartSec=90
Nice=5

[Install]
WantedBy=default.target
