[Unit]
Description=C2 Inbox bounded semantic maintenance
After=network-online.target codex-roadmap-sync.service
Wants=network-online.target
ConditionPathExists=%h/.local/share/c2-supervisor/worktree/tools/c2_inbox_codex_executor.py

[Service]
Type=oneshot
ExecStartPre=/usr/bin/python3 %h/.local/share/c2-supervisor/worktree/tools/c2_worktree_guard.py --sync
ExecStartPre=/usr/bin/python3 %h/.local/share/c2-supervisor/worktree/tools/c2_snapshot_sync.py
ExecStart=/usr/bin/python3 %h/.local/share/c2-supervisor/worktree/tools/c2_inbox_codex_executor.py --db %h/.local/state/c2-supervisor/roadmap.sqlite3 --batch 25
TimeoutStartSec=55min
Nice=8
